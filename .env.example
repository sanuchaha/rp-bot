# Скопируйте этот файл в .env и заполните переменные.

# Telegram bot token от @BotFather
BOT_TOKEN=123456:ABC-...

# Список chat_id, в которых боту разрешено работать (через запятую).
# Если пусто — бот отвечает везде (для локальной разработки).
# Узнать chat_id группы: добавить @RawDataBot в группу, или прочитать chat.id из логов.
ALLOWED_CHAT_IDS=-1001234567890

# Postgres connection string из Neon (https://neon.tech).
# Пример: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Если не задан — бот пишет в локальный файл data.json (для разработки).
DATABASE_URL=

# Включить webhook-режим. Если задан — бот поднимает HTTP-сервер на $PORT
# и регистрирует webhook на этом URL у Telegram.
# На Render значение RENDER_EXTERNAL_URL подставляется автоматически, поэтому
# WEBHOOK_BASE_URL можно не задавать.
# WEBHOOK_BASE_URL=https://your-app.onrender.com

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token (опционально).
# WEBHOOK_SECRET=

# Порт HTTP-сервера в webhook-режиме (Render задаёт PORT автоматически).
# PORT=8080
